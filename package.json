{
  "name": "mono-1",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run check-types",
    "format": "prettier -w .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
