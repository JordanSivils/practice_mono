  },
  "devDependencies": {
    "@repo/prettier-config": "workspace:*",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.26.2"
    }
  },
